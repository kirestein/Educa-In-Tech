# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT
JWT_SIGNING_KEY=change-me-with-at-least-32-characters
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Database (Neon/PostgreSQL via URL - recomendado em produção)
# DATABASE_URL=postgresql://<USUARIO>:<SENHA>@ep-<hash>.c-2.us-east-1.aws.neon.tech/<NOME_DO_BANCO>?sslmode=require&channel_binding=require
DB_CONN_MAX_AGE=600

# Database (fallback por campos separados / opcional)
# POSTGRES_DB=educa
# POSTGRES_USER=educa
# POSTGRES_PASSWORD=educa
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Google Sheets integration
GOOGLE_SHEETS_CREDENTIALS_FILE=/absolute/path/to/google-service-account.json
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=
GOOGLE_SHEETS_DEFAULT_WORKSHEET=dashboard_turmas

# Self-hosted LLM (Ollama) + RAG
LOCAL_LLM_ENABLED=True
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_MAX_CONTEXT_DOCS=8
